<?xml version="1.0"?>
<!-- Hermes engine with an ungated Catalyst SST stream on solution-io.
     Materialized by jarvis from the Incompact3d package when
     catalyst_stream is set and trigger=false. Every output step ships
     over SST; an external reader (e.g. pvbatch tgv-pipeline.py
     -j tgv-fides.json -b <output>/<stream> - -staging) must connect:
     the writer blocks in Open until rendezvous. -->
<adios-config>
<io name="solution-io">
    <engine type="Plugin">
        <parameter key="PluginName" value="hermes"/>
        <parameter key="PluginLibrary" value="hermes_engine"/>
        <parameter key="ppn" value="##ppn##"/>
        <parameter key="db_file" value="##db_path##"/>
        <parameter key="TimeDerivVar" value="pp"/>
        <parameter key="TimeDerivOutputs" value="dpdt,d2pdt2"/>
        <parameter key="TimeDerivDt" value="0.005"/>
        <parameter key="TimeDerivCenterTag" value="1"/>
        <parameter key="Script" value="##script##"/>
        <parameter key="DataModel" value="##data_model##"/>
        <parameter key="CatalystStream" value="##catalyst_stream##"/>
        <parameter key="SSTDataTransport" value="##sst_data_transport##"/>
        ##sst_queue_policy_line##
    </engine>
    <transport type="File">
        <parameter key="Library" value="fstream"/>
        <parameter key="ProfileUnits" value="Milliseconds"/>
    </transport>
</io>
<io name="in-outflow-io">
    <engine type="Plugin">
        <parameter key="PluginName" value="hermes"/>
        <parameter key="PluginLibrary" value="hermes_engine"/>
        <parameter key="ppn" value="##ppn##"/>
        <parameter key="db_file" value="##db_path##"/>
    </engine>
    <transport type="File">
        <parameter key="Library" value="fstream"/>
        <parameter key="ProfileUnits" value="Milliseconds"/>
    </transport>
</io>
<io name="turb-io">
    <engine type="Plugin">
        <parameter key="PluginName" value="hermes"/>
        <parameter key="PluginLibrary" value="hermes_engine"/>
        <parameter key="ppn" value="##ppn##"/>
        <parameter key="db_file" value="##db_path##"/>
    </engine>
    <transport type="File">
        <parameter key="Library" value="fstream"/>
        <parameter key="ProfileUnits" value="Milliseconds"/>
    </transport>
</io>
<io name="restart-io">
    <engine type="Plugin">
        <parameter key="PluginName" value="hermes"/>
        <parameter key="PluginLibrary" value="hermes_engine"/>
        <parameter key="ppn" value="##ppn##"/>
        <parameter key="db_file" value="##db_path##"/>
    </engine>
    <transport type="File">
        <parameter key="Library" value="fstream"/>
        <parameter key="ProfileUnits" value="Milliseconds"/>
    </transport>
</io>
<io name="statistics-io">
    <engine type="Plugin">
        <parameter key="PluginName" value="hermes"/>
        <parameter key="PluginLibrary" value="hermes_engine"/>
        <parameter key="ppn" value="##ppn##"/>
        <parameter key="db_file" value="##db_path##"/>
    </engine>
    <transport type="File">
        <parameter key="Library" value="fstream"/>
        <parameter key="ProfileUnits" value="Milliseconds"/>
    </transport>
</io>
<io name="restart-forces-io">
    <engine type="Plugin">
        <parameter key="PluginName" value="hermes"/>
        <parameter key="PluginLibrary" value="hermes_engine"/>
        <parameter key="ppn" value="##ppn##"/>
        <parameter key="db_file" value="##db_path##"/>
    </engine>
    <transport type="File">
        <parameter key="Library" value="fstream"/>
        <parameter key="ProfileUnits" value="Milliseconds"/>
    </transport>
</io>
</adios-config>
